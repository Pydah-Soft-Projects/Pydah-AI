# -------------------------------------------------------------
# Option 1: Direct Google Gemini API (Recommended for Free High-Speed Tool Calling)
# Get your free API key at Google AI Studio: https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# -------------------------------------------------------------
# Option 2: OpenRouter API (Alternative LLM Gateway)
# -------------------------------------------------------------
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Server Configuration
PORT=8000
REQUEST_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=10

# Application Backend Service Base URLs (For Tool Execution Dispatch)
STUDENT_SERVICE_URL=http://localhost:3001
FEE_SERVICE_URL=http://localhost:3002
TRANSPORT_SERVICE_URL=http://localhost:3003
