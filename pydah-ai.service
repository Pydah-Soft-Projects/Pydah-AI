[Unit]
Description=Pydah AI Central GenAI Engine Service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/Pydah-AI
EnvironmentFile=/home/ec2-user/Pydah-AI/.env
ExecStart=/home/ec2-user/Pydah-AI/.venv/bin/uvicorn src.api:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

